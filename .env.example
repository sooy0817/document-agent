# Copy to .env for Docker Compose; application reads process environment.
# No real credentials or PDFs belong in source control.
POSTGRES_DB=nh_document
POSTGRES_USER=nh_document
POSTGRES_PASSWORD=local_development_only
POSTGRES_PORT=5433
NH_ARTIFACT_ROOT=./data/runs
NH_MAX_BYTES=26214400
NH_MAX_PAGES=200
NH_RENDER_DPI=120
NH_MAX_PIXELS=20000000
# Phase 5 only:
DATABASE_URL=postgresql+psycopg://nh_document:local_development_only@localhost:5433/nh_document
# Phase 4 only; never used by Phase 1:
OPENAI_API_KEY=
OPENAI_MODEL=
