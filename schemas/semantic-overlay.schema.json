        },
        "parent_id": {
          "title": "Parent Id",
          "type": "string"
        },
        "child_id": {
          "title": "Child Id",
          "type": "string"
        },
        "relation_type": {
          "enum": [
            "parent_child",
            "alternative_label",
            "annotation",
            "continuation",
            "related_adjustment"
          ],
          "title": "Relation Type",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "methods": {
          "items": {
            "type": "string"
          },
          "title": "Methods",
          "type": "array"
        },
        "conflicts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
