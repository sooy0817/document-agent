    "PatchDecision": {
      "additionalProperties": false,
      "properties": {
        "proposal": {
          "$ref": "#/$defs/SemanticPatch"
        },
        "validation_status": {
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "review_required"
