        "source_refs",
        "text_raw",
        "axis",
        "table_id",
        "section_id",
        "panel_id",
        "page_number",
        "order",
        "physical_evidence"
      ],
      "title": "SemanticFeature",
      "type": "object"
    },
    "SemanticNode": {
