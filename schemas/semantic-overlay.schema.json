        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "physical_status": {
          "title": "Physical Status",
          "type": "string"
        }
      },
      "required": [
        "cell_id",
        "text_raw",
        "bbox",
        "physical_status"
