      "title": "CellSnapshot",
      "type": "object"
    },
    "NumberMarker": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "title": "Family",
          "type": "string"
        },
        "token": {
          "title": "Token",
          "type": "string"
        },
