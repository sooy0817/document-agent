        "$ref": "#/$defs/RelationCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/PatchDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "table_nodes": {
      "items": {
        "$ref": "#/$defs/SemanticNode"
      },
      "title": "Table Nodes",
      "type": "array"
    },
    "document_nodes": {
      "items": {
        "$ref": "#/$defs/SemanticNode"
      },
      "title": "Document Nodes",
      "type": "array"
    },
    "source_cells": {
      "items": {
        "$ref": "#/$defs/CellSnapshot"
      },
