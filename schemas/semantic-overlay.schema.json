  "required": [
    "document_id",
    "accounting_scope",
    "scope_provenance",
    "run_id",
    "mode",
    "model_id",
    "input_hashes",
    "features",
    "candidates",
    "decisions",
    "table_nodes",
    "document_nodes",
    "source_cells",
    "calls",
    "escalations",
    "status"
