{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BBox": {
      "additionalProperties": false,
      "description": "Unrotated visible page, PDF points, top-left origin (72 pt/in).",
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Boundary": {
      "additionalProperties": false,
      "properties": {
        "boundary_id": {
          "title": "Boundary Id",
          "type": "string"
        },
        "axis": {
          "enum": [
            "horizontal",
            "vertical"
          ],
          "title": "Axis",
          "type": "string"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "position": {
          "title": "Position",
          "type": "number"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "status": {
          "enum": [
            "present",
            "absent",
            "uncertain",
            "inferred"
          ],
          "title": "Status",
          "type": "string"
        },
        "line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Line Ids",
          "type": "array"
        },
        "evidence_level": {
          "default": "observed",
          "enum": [
            "observed",
            "small_gap_bridged",
            "endpoint_alignment",
            "text_conflict",
            "missing",
            "fill_transition"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "text_conflict_span_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Text Conflict Span Ids",
          "type": "array"
        }
      },
      "required": [
        "boundary_id",
        "axis",
        "row",
        "column",
        "position",
        "start",
        "end",
        "coverage",
        "status",
        "line_ids"
      ],
      "title": "Boundary",
      "type": "object"
    },
    "CellIR": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "minLength": 1,
          "title": "Cell Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "column_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Index"
        },
        "rowspan": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rowspan"
        },
        "colspan": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colspan"
        },
        "text_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Raw"
        },
        "span_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Span Refs",
          "type": "array"
        },
        "extraction_status": {
          "enum": [
            "observed",
            "blank",
            "unreadable"
          ],
          "title": "Extraction Status",
          "type": "string"
        }
      },
      "required": [
        "cell_id",
        "source",
        "text_raw",
        "extraction_status"
      ],
      "title": "CellIR",
      "type": "object"
    },
    "GridBand": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "index",
        "start",
        "end"
      ],
      "title": "GridBand",
      "type": "object"
    },
    "GridPolicy": {
      "additionalProperties": false,
      "properties": {
        "tolerance": {
          "default": 0.75,
          "exclusiveMinimum": 0,
          "maximum": 3,
          "title": "Tolerance",
          "type": "number"
        },
        "min_line_length": {
          "default": 12,
          "exclusiveMinimum": 0,
          "title": "Min Line Length",
          "type": "number"
        },
        "max_grid_slots": {
          "default": 20000,
          "exclusiveMinimum": 0,
          "title": "Max Grid Slots",
          "type": "integer"
        },
        "raster_threshold": {
          "default": 100,
          "maximum": 255,
          "minimum": 0,
          "title": "Raster Threshold",
          "type": "integer"
        },
        "max_lines": {
          "default": 6000,
          "exclusiveMinimum": 0,
          "title": "Max Lines",
          "type": "integer"
        },
        "max_small_gap": {
          "default": 2.0,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Small Gap",
          "type": "number"
        },
        "minimum_gap_coverage": {
          "default": 0.94,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Gap Coverage",
          "type": "number"
        },
        "raster_strategy": {
          "default": "adaptive_contrast",
          "enum": [
            "legacy_dark",
            "adaptive_dark",
            "adaptive_contrast"
          ],
          "title": "Raster Strategy",
          "type": "string"
        },
        "raster_contrast": {
          "default": 12,
          "maximum": 100,
          "minimum": 1,
          "title": "Raster Contrast",
          "type": "integer"
        },
        "infer_open_outer": {
          "default": true,
          "title": "Infer Open Outer",
          "type": "boolean"
        }
      },
      "title": "GridPolicy",
      "type": "object"
    },
    "Intersection": {
      "additionalProperties": false,
      "properties": {
        "intersection_id": {
          "title": "Intersection Id",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Line Ids",
          "type": "array"
        }
      },
      "required": [
        "intersection_id",
        "x",
        "y",
        "line_ids"
      ],
      "title": "Intersection",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "source_references": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source References",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "LineSegment": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "minLength": 1,
          "title": "Line Id",
          "type": "string"
        },
        "axis": {
          "enum": [
            "horizontal",
            "vertical"
          ],
          "title": "Axis",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "number"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "method": {
          "enum": [
            "vector",
            "raster"
          ],
          "title": "Method",
          "type": "string"
        },
        "evidence_kind": {
          "default": "stroke",
          "enum": [
            "stroke",
            "fill_transition"
          ],
          "title": "Evidence Kind",
          "type": "string"
        }
      },
      "required": [
        "line_id",
        "axis",
        "position",
        "start",
        "end",
        "source",
        "method"
      ],
      "title": "LineSegment",
      "type": "object"
    },
    "PhysicalCell": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "minLength": 1,
          "title": "Cell Id",
          "type": "string"
        },
        "row_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index"
        },
        "column_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Index"
        },
        "rowspan": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rowspan"
        },
        "colspan": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Colspan"
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original Text"
        },
        "source_bbox": {
          "$ref": "#/$defs/BBox"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "source_cell_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Cell Ids",
          "type": "array"
        },
        "span_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Span Refs",
          "type": "array"
        },
        "extraction_method": {
          "enum": [
            "vector_grid",
            "raster_grid",
            "mixed_grid",
            "unresolved"
          ],
          "title": "Extraction Method",
          "type": "string"
        },
        "status": {
          "enum": [
            "resolved",
            "inferred",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "boundary_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Boundary Ids",
          "type": "array"
        },
        "occupied_slots": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Occupied Slots",
          "type": "array"
        }
      },
      "required": [
        "cell_id",
        "row_index",
        "column_index",
        "rowspan",
        "colspan",
        "original_text",
        "source_bbox",
        "source",
        "extraction_method",
        "status",
        "occupied_slots"
      ],
      "title": "PhysicalCell",
      "type": "object"
    },
    "RasterRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "width_pixels": {
          "exclusiveMinimum": 0,
          "title": "Width Pixels",
          "type": "integer"
        },
        "height_pixels": {
          "exclusiveMinimum": 0,
          "title": "Height Pixels",
          "type": "integer"
        },
        "dpi": {
          "exclusiveMinimum": 0,
          "title": "Dpi",
          "type": "integer"
        },
        "page_to_pixel": {
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Page To Pixel",
          "type": "array"
        },
        "clip": {
          "$ref": "#/$defs/BBox"
        }
      },
      "required": [
        "artifact",
        "width_pixels",
        "height_pixels",
        "dpi",
        "page_to_pixel",
        "clip"
      ],
      "title": "RasterRef",
      "type": "object"
    },
    "SourceCellLink": {
      "additionalProperties": false,
      "properties": {
        "source_cell_id": {
          "title": "Source Cell Id",
          "type": "string"
        },
        "reconstructed_cell_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reconstructed Cell Id"
        },
        "relation": {
          "enum": [
            "exact",
            "overlap",
            "unresolved"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "source_cell_id",
        "reconstructed_cell_id",
        "relation"
      ],
      "title": "SourceCellLink",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "page_number": {
          "exclusiveMinimum": 0,
          "title": "Page Number",
          "type": "integer"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "cell_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Id"
        }
      },
      "required": [
        "document_id",
        "page_number",
        "bbox"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "physical-table-ir/2.1",
      "default": "physical-table-ir/2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "table_id": {
      "minLength": 1,
      "title": "Table Id",
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "analysis_run_id": {
      "format": "uuid",
      "title": "Analysis Run Id",
      "type": "string"
    },
    "analyzer_version": {
      "default": "physical-grid/0.2.0",
      "title": "Analyzer Version",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/GridPolicy"
    },
    "source_ir_sha256": {
      "title": "Source Ir Sha256",
      "type": "string"
    },
    "page_number": {
      "exclusiveMinimum": 0,
      "title": "Page Number",
      "type": "integer"
    },
    "bounding_box": {
      "$ref": "#/$defs/BBox"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/GridBand"
      },
      "title": "Rows",
      "type": "array"
    },
    "columns": {
      "items": {
        "$ref": "#/$defs/GridBand"
      },
      "title": "Columns",
      "type": "array"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/PhysicalCell"
      },
      "title": "Cells",
      "type": "array"
    },
    "source_cells": {
      "items": {
        "$ref": "#/$defs/CellIR"
      },
      "title": "Source Cells",
      "type": "array"
    },
    "source_links": {
      "items": {
        "$ref": "#/$defs/SourceCellLink"
      },
      "title": "Source Links",
      "type": "array"
    },
    "unassigned_source_cell_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unassigned Source Cell Ids",
      "type": "array"
    },
    "table_candidate_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Table Candidate Ids",
      "type": "array"
    },
    "page_refs": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "integer"
      },
      "title": "Page Refs",
      "type": "array"
    },
    "source_references": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source References",
      "type": "array"
    },
    "crop_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RasterRef"
      },
      "title": "Crop Refs",
      "type": "array"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/LineSegment"
      },
      "title": "Lines",
      "type": "array"
    },
    "intersections": {
      "items": {
        "$ref": "#/$defs/Intersection"
      },
      "title": "Intersections",
      "type": "array"
    },
    "boundaries": {
      "items": {
        "$ref": "#/$defs/Boundary"
      },
      "title": "Boundaries",
      "type": "array"
    },
    "unresolved_boundaries": {
      "items": {
        "$ref": "#/$defs/Boundary"
      },
      "title": "Unresolved Boundaries",
      "type": "array"
    },
    "validation_issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Validation Issues",
      "type": "array"
    },
    "analysis_state": {
      "default": "candidate",
      "enum": [
        "candidate",
        "validated",
        "partial",
        "review_required",
        "invalid"
      ],
      "title": "Analysis State",
      "type": "string"
    }
  },
  "required": [
    "table_id",
    "document_id",
    "analysis_run_id",
    "policy",
    "source_ir_sha256",
    "page_number",
    "bounding_box",
    "rows",
    "columns",
    "cells",
    "source_cells",
    "source_links",
    "page_refs",
    "source_references",
    "lines",
    "intersections",
    "boundaries",
    "unresolved_boundaries"
  ],
  "title": "PhysicalTableIR",
  "type": "object"
}