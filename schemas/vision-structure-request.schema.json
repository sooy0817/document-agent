          "title": "Line Ids",
          "type": "array"
        }
      },
      "required": [
        "intersection_id",
        "x",
        "y",
        "line_ids"
      ],
      "title": "Intersection",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
