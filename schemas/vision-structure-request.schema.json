{
  "$defs": {
    "Ambiguity": {
      "additionalProperties": false,
      "properties": {
        "ambiguity_id": {
          "title": "Ambiguity Id",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        },
        "candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "review_regions": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Review Regions",
          "type": "array"
        }
      },
      "required": [
        "ambiguity_id",
        "code",
        "reason",
        "target_ids",
        "review_regions"
      ],
      "title": "Ambiguity",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BBox": {
      "additionalProperties": false,
      "description": "Unrotated visible page, PDF points, top-left origin (72 pt/in).",
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Boundary": {
      "additionalProperties": false,
      "properties": {
        "boundary_id": {
          "title": "Boundary Id",
          "type": "string"
        },
        "axis": {
          "enum": [
            "horizontal",
            "vertical"
          ],
          "title": "Axis",
          "type": "string"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "position": {
          "title": "Position",
          "type": "number"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "status": {
          "enum": [
            "present",
            "absent",
            "uncertain",
            "inferred"
          ],
          "title": "Status",
          "type": "string"
        },
        "line_ids": {
          "items": {
            "type": "string"
          },
          "title": "Line Ids",
          "type": "array"
        },
        "evidence_level": {
          "default": "observed",
          "enum": [
            "observed",
            "small_gap_bridged",
            "endpoint_alignment",
            "text_conflict",
            "missing",
            "fill_transition"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "text_conflict_span_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Text Conflict Span Ids",
          "type": "array"
        }
      },
      "required": [
        "boundary_id",
        "axis",
        "row",
        "column",
        "position",
        "start",
        "end",
        "coverage",
        "status",
        "line_ids"
      ],
      "title": "Boundary",
      "type": "object"
    },
    "CellIR": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "minLength": 1,
          "title": "Cell Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "column_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Index"
        },
        "rowspan": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rowspan"
        },
        "colspan": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colspan"
        },
        "text_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Raw"
        },
        "span_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Span Refs",
          "type": "array"
        },
        "extraction_status": {
          "enum": [
            "observed",
            "blank",
            "unreadable"
          ],
          "title": "Extraction Status",
          "type": "string"
        }
      },
      "required": [
        "cell_id",
        "source",
        "text_raw",
        "extraction_status"
      ],
      "title": "CellIR",
      "type": "object"
    },
    "CellPath": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "title": "Cell Id",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original Text"
        },
        "panel_id": {
          "title": "Panel Id",
          "type": "string"
        },
        "row_path": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Row Path",
          "type": "array"
        },
        "column_path": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Column Path",
          "type": "array"
        },
        "row_candidates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Row Candidates",
          "type": "array"
        },
        "column_candidates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Column Candidates",
          "type": "array"
        },
        "evidence_state": {
          "enum": [
            "observed",
            "inferred",
            "unresolved"
          ],
          "title": "Evidence State",
          "type": "string"
        }
      },
      "required": [
        "cell_id",
        "bbox",
        "original_text",
        "panel_id",
        "evidence_state"
      ],
      "title": "CellPath",
      "type": "object"
    },
    "CellRole": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "title": "Cell Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "corner",
            "row_label",
            "column_header",
            "value",
            "unknown"
          ],
          "title": "Role",
          "type": "string"
        },
        "evidence_state": {
          "enum": [
            "observed",
            "inferred",
            "unresolved"
          ],
          "title": "Evidence State",
          "type": "string"
        }
      },
      "required": [
        "cell_id",
        "role",
        "evidence_state"
      ],
      "title": "CellRole",
      "type": "object"
    },
    "GridBand": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "index",
        "start",
        "end"
      ],
      "title": "GridBand",
      "type": "object"
    },
    "GridPolicy": {
      "additionalProperties": false,
      "properties": {
        "tolerance": {
          "default": 0.75,
          "exclusiveMinimum": 0,
          "maximum": 3,
          "title": "Tolerance",
          "type": "number"
        },
        "min_line_length": {
          "default": 12,
          "exclusiveMinimum": 0,
          "title": "Min Line Length",
          "type": "number"
        },
        "max_grid_slots": {
          "default": 20000,
          "exclusiveMinimum": 0,
          "title": "Max Grid Slots",
          "type": "integer"
        },
        "raster_threshold": {
          "default": 100,
          "maximum": 255,
          "minimum": 0,
          "title": "Raster Threshold",
          "type": "integer"
        },
        "max_lines": {
          "default": 6000,
          "exclusiveMinimum": 0,
          "title": "Max Lines",
          "type": "integer"
        },
        "max_small_gap": {
          "default": 2.0,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Small Gap",
          "type": "number"
        },
        "minimum_gap_coverage": {
          "default": 0.94,
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Gap Coverage",
          "type": "number"
        },
        "raster_strategy": {
          "default": "adaptive_contrast",
          "enum": [
            "legacy_dark",
            "adaptive_dark",
            "adaptive_contrast"
          ],
          "title": "Raster Strategy",
          "type": "string"
        },
        "raster_contrast": {
          "default": 12,
          "maximum": 100,
          "minimum": 1,
          "title": "Raster Contrast",
          "type": "integer"
        },
        "infer_open_outer": {
          "default": true,
          "title": "Infer Open Outer",
          "type": "boolean"
        }
      },
      "title": "GridPolicy",
      "type": "object"
    },
    "HierarchyNode": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "axis": {
          "enum": [
            "row",
            "column"
