        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "candidate_parent_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidate Parent Ids",
          "type": "array"
        },
        "source_cell_id": {
          "title": "Source Cell Id",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "row_range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Row Range",
          "type": "array"
        },
        "column_range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Column Range",
          "type": "array"
        },
        "physical_evidence": {
          "enum": [
            "observed",
            "inferred",
            "unresolved"
          ],
          "title": "Physical Evidence",
          "type": "string"
        },
        "evidence_state": {
          "default": "inferred",
          "enum": [
            "observed",
            "inferred",
            "unresolved"
          ],
          "title": "Evidence State",
          "type": "string"
        },
        "boundary_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Boundary Ids",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "axis",
        "panel_id",
        "label_raw",
        "source_cell_id",
        "bbox",
        "row_range",
        "column_range",
        "physical_evidence"
      ],
      "title": "HierarchyNode",
      "type": "object"
    },
    "Intersection": {
      "additionalProperties": false,
      "properties": {
