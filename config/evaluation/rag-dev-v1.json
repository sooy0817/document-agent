    {"id": "bd-07", "type": "body", "question": "강동농협 재무현황의 금융업대출채권은 무엇을 차감한 금액인가요?", "gold": [{"doc": "gangdong", "page": 2, "text": "대손충당금을 차감한 금액"}], "expected": ["대손충당금"], "note": "표 아래 주석(note)에만 있다."},
