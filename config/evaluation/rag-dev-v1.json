    {"id": "amb-01",
     "type": "ambiguous",
     "question": "만기 2개월 됐을때의 이자율은?",
     "gold": [{"doc": "kb", "page": 5, "text": "만기이자율 X 30%", "row_label": "만기후 1개월초과~3개월이내", "conditional_terms": [["KB", "국민은행"], ["만기 후", "만기일 이후", "만기 이후"], ["2개월", "두 달", "두달", "1개월 초과 3개월 이내"], ["라면", "이라면", "가정", "경우", "기준으로", "해당한다면", "경과했다면"]], "value_aliases": ["일반정기예금 고시이자율 × 30%", "일반정기예금 고시이자율 × 0.30", "일반정기예금 고시이자율의 30%"]}],
